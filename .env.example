# Clon nuevo: copie como .env y complete los tres campos de cámara.
# Instalación compartida: deje esos campos fuera de su .env local para heredarlos.
# Prioridad: variables del proceso > este .env > .env del proyecto anterior.
# No copies contraseñas a documentación ni a Git.
DETECTCAM_CAMERA_IP=
DETECTCAM_CAMERA_USER=
DETECTCAM_CAMERA_PASSWORD=

# Sigue iniciando desarmado al habilitar hardware; Armar PTZ es explícito.
DETECTCAM_PTZ_HARDWARE_ENABLED=false
DETECTCAM_PTZ_BACKEND=auto
# Archivo local o ruta absoluta; los pesos no se incluyen en Git.
DETECTCAM_MODEL_PATH=model/best.pt
# cpu o índice CUDA (0). Instalar CUDA no selecciona automáticamente GPU.
# DETECTCAM_DEVICE=0
# DETECTCAM_IMGSZ=640
# Clases iniciales: application.initial_classes en settings.toml.
# DETECTCAM_TARGET_MIN_CONFIDENCE=0.50
# DETECTCAM_PTZ_METRICS_ENABLED=true
# DETECTCAM_MEDIA_DIR=/ruta/a/videos

# Ganancias, tiempos y límites NUEVOS: settings.toml.
# Los ajustes antiguos SAFE/MAX_MISSED_FRAMES no gobiernan el nuevo core.
