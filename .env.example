# Copie este archivo como .env y complete los datos de su cámara.
# Nunca suba .env al repositorio.
# Obligatorios: CAMERA_IP, CAMERA_USER, CAMERA_PASSWORD y MODEL_PATH.
# No escriba rtsp:// ni credenciales dentro de CAMERA_IP.
DETECTCAM_CAMERA_IP=192.168.1.100
DETECTCAM_CAMERA_USER=
DETECTCAM_CAMERA_PASSWORD=
DETECTCAM_RTSP_CHANNEL=101
# Recepción: un hilo evita la cola de decodificación entre frames.
# UDP sólo como prueba en LAN estable; TCP conserva entrega completa.
DETECTCAM_RTSP_LOW_LATENCY=true
DETECTCAM_RTSP_TRANSPORT=tcp
DETECTCAM_RTSP_DECODER_THREADS=1
DETECTCAM_ISAPI_PORT=80
DETECTCAM_ONVIF_PORT=80
DETECTCAM_PTZ_CHANNEL=1

# Modelo e inferencia. La ruta relativa se resuelve desde la raíz del proyecto.
DETECTCAM_MODEL_PATH=model/best.pt
# cpu para procesador; 0 para la primera GPU NVIDIA, 1 para la segunda.
# NVIDIA requiere driver y PyTorch con CUDA; consulte la instalación en README.md.
DETECTCAM_DEVICE=cpu
# Reduzca a 416 o 320 si falta memoria de GPU; puede perder detecciones pequeñas.
DETECTCAM_IMGSZ=640
DETECTCAM_CONFIDENCE=0.25
# Nombres de clases de su modelo separados por comas; ajuste estos ejemplos.
DETECTCAM_TARGET_CLASSES=drone,airplane,helicopter,bird
DETECTCAM_TARGET_MIN_CONFIDENCE=0.50
DETECTCAM_TARGET_CONFIDENCE_WEIGHT=0.90
DETECTCAM_TARGET_CENTER_WEIGHT=0.00
DETECTCAM_TARGET_SIZE_WEIGHT=0.10

# El perfil SAFE es el único perfil publicado por ahora.
DETECTCAM_PTZ_TUNING_PROFILE=SAFE
DETECTCAM_PTZ_BACKEND=auto
DETECTCAM_PTZ_KP_PAN=0.50
DETECTCAM_PTZ_KP_TILT=0.50
DETECTCAM_PTZ_MAX_PAN_COMMAND=0.35
DETECTCAM_PTZ_MAX_TILT_COMMAND=0.35
DETECTCAM_PTZ_PHYSICAL_MAX_PAN=0.30
DETECTCAM_PTZ_PHYSICAL_MAX_TILT=0.30
DETECTCAM_PTZ_PHYSICAL_MAX_ZOOM=0.00
DETECTCAM_PTZ_MIN_TRACK_CONFIDENCE=0.50
DETECTCAM_PTZ_LOST_COAST_MS=300
DETECTCAM_TRACK_MAX_MISSED_FRAMES=10

# Seguros: al iniciar no se conecta ni mueve hardware.
DETECTCAM_PTZ_HARDWARE_ENABLED=false
DETECTCAM_PTZ_POSITION3D_ENABLED=false
DETECTCAM_PTZ_AUTO_ZOOM_ENABLED=false
DETECTCAM_PTZ_MAX_CONTINUOUS_MS=400
DETECTCAM_PTZ_EXECUTOR_HEARTBEAT_MS=500
DETECTCAM_PTZ_MAX_TARGET_AGE_MS=300
DETECTCAM_PTZ_MAX_FRAME_AGE_MS=500
DETECTCAM_PTZ_MIN_VISIBLE_FRAMES=3
DETECTCAM_PTZ_COMMAND_INTERVAL_MS=200

# Métricas opcionales; sus archivos se escriben en runs/ y Git los ignora.
DETECTCAM_PTZ_METRICS_ENABLED=false
DETECTCAM_PTZ_RECENTER_STABLE_MS=300
